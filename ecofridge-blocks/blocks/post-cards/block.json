{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "ecofridge",
  "textdomain": "ecofridge-blocks",
  "editorScript": "efb-editor",
  "editorStyle": "efb-editor",
  "style": "efb-blocks",
  "render": "file:./render.php",
  "name": "efb/post-cards",
  "title": "Post Cards",
  "description": "Latest posts, brochures or videos as cards.",
  "icon": "excerpt-view",
  "attributes": {
    "postType": {
      "type": "string",
      "default": "post"
    },
    "count": {
      "type": "number",
      "default": 6
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "showDate": {
      "type": "boolean",
      "default": true
    },
    "ids": {
      "type": "array",
      "default": []
    },
    "order": {
      "type": "string",
      "default": "desc"
    },
    "linkToFile": {
      "type": "boolean",
      "default": false
    },
    "embedVideo": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    }
  }
}
