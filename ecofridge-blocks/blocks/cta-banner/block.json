{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "ecofridge",
  "textdomain": "ecofridge-blocks",
  "editorScript": "efb-editor",
  "editorStyle": "efb-editor",
  "style": "efb-blocks",
  "render": "file:./render.php",
  "name": "efb/cta-banner",
  "title": "Call-to-action Banner",
  "description": "Banner with a message, phone number and optional button.",
  "icon": "megaphone",
  "attributes": {
    "text": {
      "type": "string",
      "default": "Call us today -"
    },
    "phone": {
      "type": "string",
      "default": "01280 811411"
    },
    "buttonText": {
      "type": "string",
      "default": ""
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "bgColor": {
      "type": "string",
      "default": "#1f1f1f"
    },
    "bgImageId": {
      "type": "number",
      "default": 0
    },
    "bgImageUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true
    }
  }
}