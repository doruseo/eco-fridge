{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "ecofridge",
  "textdomain": "ecofridge-blocks",
  "editorScript": "efb-editor",
  "editorStyle": "efb-editor",
  "style": "efb-blocks",
  "render": "file:./render.php",
  "name": "efb/offer-cards",
  "title": "Offer Cards",
  "description": "Linked offer cards: highlighted price label, image, title and model.",
  "icon": "tag",
  "attributes": {
    "items": {
      "type": "array",
      "default": []
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "labelColor": {
      "type": "string",
      "default": "#ff0000"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    }
  }
}
