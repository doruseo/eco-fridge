{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "ecofridge",
  "textdomain": "ecofridge-blocks",
  "editorScript": "efb-editor",
  "editorStyle": "efb-editor",
  "style": "efb-blocks",
  "render": "file:./render.php",
  "name": "efb/product-search",
  "title": "Product Search",
  "description": "Live (AJAX) search for products and product categories.",
  "icon": "search",
  "attributes": {
    "placeholder": {
      "type": "string",
      "default": "Search for products..."
    },
    "buttonText": {
      "type": "string",
      "default": "Search"
    },
    "showButton": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    }
  }
}
