{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "category": "ecofridge",
  "textdomain": "ecofridge-blocks",
  "editorScript": "efb-editor",
  "editorStyle": "efb-editor",
  "style": "efb-blocks",
  "render": "file:./render.php",
  "name": "efb/toggle",
  "title": "Toggle (show on click)",
  "description": "Collapsible panel: the content stays hidden until the visitor clicks the title (e.g. warranty prices offered on request).",
  "icon": "arrow-down-alt2",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Show more"
    },
    "open": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "background": true,
      "text": true,
      "link": true
    }
  }
}
