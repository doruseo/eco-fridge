          "title": "Commercial Freezers",
          "imageId": 0,
          "imageUrl": ""
        },
        {
          "categoryId": 44,
          "title": "Display Cabinets",
          "imageId": 0,
          "imageUrl": ""
        },
        {
          "categoryId": 45,
          "title": "Storage Cabinets",
          "imageId": 0,
          "imageUrl": ""
        }
      ]
